# gx10 profile for ~/git/Kolibri-1-DGX-Spark — copy to its .env. NVFP4 experts, 1M ctx, KV pool sized so the k3s stacks keep headroom (see README.md).
QUANT=nvfp4
MAX_MODEL_LEN=1048576
KV_CACHE_GIB=24
MAX_NUM_SEQS=4
LOAD_STRATEGY=eager
# default reasoning effort for clients that do not send one (template default is high)
EXTRA_ARGS=--default-chat-template-kwargs {"reasoning_effort":"medium"}
